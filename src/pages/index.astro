---
import Atmosphere from '../components/landing/Atmosphere.astro';
import CapabilityVisual from '../components/landing/CapabilityVisual.astro';
import Contributors from '../components/landing/Contributors.astro';
import Icon from '../components/landing/Icon.astro';
import '../styles/landing.css';

const docs = '/getting-started/quickstart/';
const github = 'https://github.com/anvie/evonic';
const installCommands = {
	'one-liner': 'curl -fsSL https://evonic.dev/install.sh | bash',
	manual: 'git clone https://github.com/anvie/evonic'
};
const workspaceTabs = [
	{ id: 'evonic', title: 'Evonic', text: 'Many agents, one Evonic.', src: '/evoagent.mp4' },
	{ id: 'evomem', title: 'Evomem', text: 'Memory that outlives the session.', src: '/evomem.mp4' },
	{ id: 'evonet', title: 'Evonet', text: 'Agents on every device.', src: '/evonet.mp4' }
];
const steps = [
	{
		title: 'Shape every agent',
		text: 'Give each agent an identity, a model, tools, and reference knowledge. Add skills as its responsibilities grow.',
		icon: 'spark',
		category: 'AGENT DESIGN',
		label: 'Agent identity',
		detail: 'A purpose. A personality. Possibilities.'
	},
	{
		title: 'Run it anywhere',
		text: 'Agents can run tools locally, on an SSH server, or through an Evonet tunnel across your infrastructure.',
		icon: 'globe',
		category: 'FLEXIBLE EXECUTION',
		label: 'Anywhere execution',
		detail: 'Local. Remote. Wherever work happens.'
	},
	{
		title: 'Build connected teams',
		text: 'Agents can message and delegate to each other, combining specialist roles into a coordinated workflow.',
		icon: 'network',
		category: 'MULTI-AGENT TEAMS',
		label: 'A connected system',
		detail: 'Independent agents. Shared possibilities.'
	}
];
const nodeGroups = [
	[
		{ label: 'Model', icon: 'code' },
		{ label: 'Knowledge', icon: 'layers' },
		{ label: 'Tools & skills', icon: 'terminal' },
		{ label: 'Channels', icon: 'chat' }
	],
	[
		{ label: 'Local', icon: 'terminal' },
		{ label: 'SSH server', icon: 'globe' },
		{ label: 'Evonet tunnel', icon: 'network' },
		{ label: 'Sandbox', icon: 'shield' }
	],
	[
		{ label: 'Research agent', icon: 'spark' },
		{ label: 'Coding agent', icon: 'code' },
		{ label: 'Writing agent', icon: 'chat' },
		{ label: 'Your workflow', icon: 'globe' }
	]
];
// Every feature keeps its own position, size, and angle across tab changes.
const nodeLayouts = [
	[
		{ x: 30, y: 28, angle: -2 },
		{ x: 70, y: 28, angle: 3 },
		{ x: 30, y: 74, angle: 2 },
		{ x: 70, y: 74, angle: -3 }
	],
	[
		{ x: 28, y: 12, angle: -7 },
		{ x: 65, y: 15, angle: 6 },
		{ x: 35, y: 88, angle: 5 },
		{ x: 72, y: 87, angle: -5 }
	],
	[
		{ x: 35, y: 43, angle: -3 },
		{ x: 72, y: 40, angle: 4 },
		{ x: 28, y: 61, angle: 6 },
		{ x: 65, y: 58, angle: -7 }
	]
];
// Rotations pivot at the connector endpoint so every line stays attached.
type SystemNode = {
	label: string;
	icon: string;
	group: number;
	side: 'left' | 'right';
	depth: number;
	x: number;
	y: number;
	angle: number;
	position: string;
};
const systemNodes: SystemNode[] = nodeGroups.flatMap((nodes, group) =>
	nodes.map((node, index) => ({
		...node,
		group,
		side: index % 2 === 0 ? 'left' : 'right',
		depth: group,
		...nodeLayouts[group][index],
		position: ['a', 'b', 'c', 'd'][index]
	}))
);
// Connector endpoints in the hero illustration share the 1000-unit diagram grid.
// Depth shrinks each node and darkens it instead of fading it, so overlapping artwork stays solid.
// A negative depth sits in front of the hub, which is where the inner trio hugs the mascot.
const heroSatellites = [
	{ label: 'Agent', x: 70, y: -150, depth: 2 },
	{ label: 'Coding', x: 105, y: -60, depth: 1 },
	{ label: 'Skills', x: 150, y: 30, depth: 0 },
	{ label: 'Models', x: 210, y: -104, depth: 2 },
	{ label: 'Research', x: 265, y: 52, depth: 0 },
	{ label: 'Tasks', x: 320, y: -170, depth: 2 },
	{ label: 'Tools', x: 380, y: -20, depth: 1 },
	{ label: 'Writing', x: 412, y: -86, depth: -1 },
	{ label: 'Sandbox', x: 500, y: -68, depth: -1 },
	{ label: 'Knowledge', x: 450, y: 42, depth: 0 },
	{ label: 'Chat', x: 588, y: -94, depth: -1 },
	{ label: 'Evonet', x: 620, y: -152, depth: 2 },
	{ label: 'Memory', x: 670, y: -40, depth: 1 },
	{ label: 'Local', x: 720, y: 58, depth: 0 },
	{ label: 'Triggers', x: 775, y: -96, depth: 1 },
	{ label: 'Channels', x: 830, y: -12, depth: 1 },
	{ label: 'Cron', x: 880, y: -140, depth: 2 },
	{ label: 'Teams', x: 925, y: 40, depth: 0 }
];
// Narrow screens get their own fan: fewer nodes, pulled onto an arc that still spans the
// section, because the desktop spacing collapses once the artwork is this small.
const narrowHeroSatellites = [
	{ label: 'Agent', x: 88, y: -57, depth: 2 },
	{ label: 'Coding', x: 188, y: 7, depth: 1 },
	{ label: 'Skills', x: 373, y: 44, depth: 0 },
	{ label: 'Writing', x: 312, y: -47, depth: -1 },
	{ label: 'Sandbox', x: 500, y: -37, depth: -1 },
	{ label: 'Chat', x: 688, y: -52, depth: -1 },
	{ label: 'Teams', x: 627, y: 44, depth: 0 },
	{ label: 'Channels', x: 812, y: 7, depth: 1 },
	{ label: 'Cron', x: 912, y: -57, depth: 2 }
];
const heroFans = [
	{ key: 'desktop', nodes: heroSatellites },
	{ key: 'narrow', nodes: narrowHeroSatellites }
];
const connectorPath = (x: number) => `M${x} 1000 C${x} 580 ${500 + (x - 500) * 0.35} 250 500 0`;
const nodeConnectionPath = (node: SystemNode) =>
	node.side === 'left'
		? `M${node.x * 10} ${node.y * 10} C390 ${node.y * 10} 400 500 500 500`
		: `M${node.x * 10} ${node.y * 10} C610 ${node.y * 10} 600 500 500 500`;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Evonic — The home your agents deserve</title>
		<meta
			name="description"
			content="Evonic is an agentic AI framework for building independent agents—and connecting them into systems that get work done. Your Models. Your Rules. Your Swarm."
		/>
		<meta name="theme-color" content="#080b12" />
		<meta property="og:title" content="Evonic — The home your agents deserve" />
		<meta
			property="og:description"
			content="Design. Deploy. Orchestrate. Build independent agents, on your terms."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
	</head>
	<body>
		<div id="top">
			<a class="skip-link" href="#main">Skip to content</a>
			<header>
				<div class="nav-wrap">
					<a class="brand" href="#top" aria-label="Evonic home"
						><img src="/img/mascot.png" alt="" width="38" height="38" />evonic<span class="brand-dot"
							>.</span
						></a
					>
					<nav aria-label="Main navigation" id="main-nav">
						<a href="#why-evonic">Why Evonic</a>
						<a href="#how-it-works">How it works</a>
						<a href={docs}>Docs <span class="nav-external">↗</span></a>
						<a href={github} target="_blank" rel="noreferrer">GitHub <Icon name="external" size={13} /></a>
					</nav>
					<a class="button button-small nav-cta" href={docs}
						>Get started <span class="button-icon"><Icon name="arrow" size={16} /></span></a
					>
					<button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="main-nav">
						<span class="menu-open"><Icon name="menu" /></span>
						<span class="menu-close" hidden><Icon name="close" /></span>
					</button>
				</div>
			</header>

			<main id="main">
				<section class="hero" aria-labelledby="hero-title">
					<div class="hero-grid" aria-hidden="true"></div>
					<div class="hero-content">
						<div class="hero-illustration hero-enter">
							<div class="hero-mascot">
								<div class="hero-ascii" aria-hidden="true"><Atmosphere /></div>
								<img
									src="/img/mascot.png"
									alt="Evonic's blue jellyfish mascot"
									width="150"
									height="150"
									fetchpriority="high"
								/>
							</div>
							{
								heroFans.map((fan) => (
									<div class={`hero-fan hero-fan-${fan.key}`}>
										{fan.nodes.map((satellite, i) => (
											<svg
												class={`hero-connectors depth-${satellite.depth}`}
												aria-hidden="true"
												viewBox="0 0 1000 1000"
												preserveAspectRatio="none"
												style={`--node-y:${satellite.y}px;--depth:${satellite.depth}`}
											>
												<path d={connectorPath(satellite.x)} vector-effect="non-scaling-stroke" />
												<path
													class="hero-particles"
													d={connectorPath(satellite.x)}
													pathLength="100"
													style={`animation-delay:${-i * 1.2}s`}
													vector-effect="non-scaling-stroke"
												/>
											</svg>
										))}
										{fan.nodes.map((satellite) => (
											<span
												class={`hero-satellite${satellite.depth < 0 ? ' hero-front' : ''}`}
												aria-hidden="true"
												style={`--anchor:${satellite.x / 10}%;--node-y:${satellite.y}px;--depth:${satellite.depth}`}
											>
												<img src="/img/mascot.png" alt="" width="72" height="72" />
											</span>
										))}
									</div>
								))
							}
						</div>
						<div class="hero-copy">
							<h1 id="hero-title" class="hero-enter">
								Agentic infrastructure<br /><span class="gradient-text">for organizations.</span>
							</h1>
							<p class="hero-description hero-enter">
								Evonic is an agentic AI framework for building independent agents—and connecting them
								into systems that get work done.
							</p>
							<div class="hero-actions hero-enter">
								<a class="button" href={docs}
									>Build your first agent <span class="button-icon"><Icon name="arrow" size={18} /></span></a
								>
								<a class="button button-outline" href={github}
									>Explore GitHub <Icon name="github" size={16} /></a
								>
							</div>
						</div>
					</div>
					<div class="hero-bottom">
						<span><span class="little-cross">✧</span> Your Models. Your Rules. Your Swarm.</span><a
							href="#why-evonic">Scroll to explore <span class="scroll-icon">↓</span></a
						>
					</div>
				</section>

				<section class="dashboard-section section-shell" id="why-evonic" aria-labelledby="dashboard-title">
					<div class="dashboard-intro">
						<div class="section-heading" data-reveal>
							<p class="eyebrow">A HOME FOR EVERY AGENT</p>
							<h2 id="dashboard-title">
								One place to<br /><span class="gradient-text">bring it together.</span>
							</h2>
							<p>
								Create agents, choose their models, manage tools, and follow their activity from one
								workspace.
							</p>
						</div>
						<div class="quick-start" data-reveal>
							<div class="quick-start-head">
								<span><i class="status-dot"></i> QUICK START</span>
								<a href={docs}>Full guide <Icon name="external" size={13} /></a>
							</div>
							<div class="install-tabs" role="tablist" aria-label="Installation method">
								<button class="active" data-mode="one-liner" role="tab" aria-selected="true">One-liner</button
								><button data-mode="manual" role="tab" aria-selected="false">Manual</button>
							</div>
							<div class="install-content" role="tabpanel">
								<p>Install everything in one command.</p>
								<div class="command-line">
									<code><span>$</span> {installCommands['one-liner']}</code>
									<button class="copy-install" aria-label="Copy install command">
										<Icon name="copy" size={15} />
										<span class="copy-label" aria-live="polite">Copy</span>
									</button>
								</div>
								<div class="quick-meta">
									<span><Icon name="code" size={14} /> Python 3.10+</span>
									<span><Icon name="globe" size={14} /> Local or cloud LLM</span>
								</div>
							</div>
						</div>
					</div>
					<div class="dashboard-frame" data-reveal>
						<div class="dashboard-topline">
							<span><i class="status-dot"></i> THE EVONIC WORKSPACE</span><span
								>Everything, connected. <Icon name="layers" size={16} /></span
							>
						</div>
						<div class="workspace-tabs" role="tablist" aria-label="Evonic workspace previews">
							{
								workspaceTabs.map((tab, i) => (
									<button
										class={`workspace-tab${i === 0 ? ' active' : ''}`}
										id={`workspace-tab-${tab.id}`}
										data-index={i}
										role="tab"
										aria-selected={i === 0}
										aria-controls={`workspace-panel-${tab.id}`}
									>
										<span class="index">0{i + 1}</span>
										<span class="workspace-tab-copy">
											<strong>{tab.title}</strong>
											<span>{tab.text}</span>
										</span>
									</button>
								))
							}
						</div>
						<div class="dashboard-visual">
							{
								workspaceTabs.map((tab, i) => (
									<div
										class="dashboard-crop"
										id={`workspace-panel-${tab.id}`}
										role="tabpanel"
										aria-labelledby={`workspace-tab-${tab.id}`}
										data-src={tab.src}
										data-title={tab.title}
										hidden={i !== 0}
									>
										{i === 0 && (
											<video
												src={tab.src}
												aria-label={`${tab.title} preview`}
												autoplay
												muted
												loop
												playsinline
												preload="auto"
											/>
										)}
									</div>
								))
							}
						</div>
					</div>
				</section>

				<div class="manifesto" aria-label="Your Models. Your Rules. Your Swarm.">
					<div class="manifesto-track" aria-hidden="true">
						<span>Your Models.</span><span>Your Rules.</span><span class="outlined-text">Your Swarm.</span
						><span>✳</span>
					</div>
				</div>

				<section class="process section-shell" id="how-it-works" aria-labelledby="process-title">
					<div class="section-heading" data-reveal>
						<p class="eyebrow">A FRAMEWORK WITH ROOM TO GROW</p>
						<h2 id="process-title">
							Start with an agent.<br /><span class="gradient-text">Build a system around it.</span>
						</h2>
					</div>
					<div class="process-stage" data-step="0">
						<div class="stage-grid" aria-hidden="true"></div>
						<div class="stage-glow" aria-hidden="true"></div>
						<div class="agent-system" role="group" aria-label="Explore agent features">
							<svg
								class="connector-lines"
								data-layer="base"
								aria-hidden="true"
								viewBox="0 0 1000 1000"
								preserveAspectRatio="none"
							>
								{
									systemNodes.map((node) => (
										<path
											class={`connector-base${node.group === 0 ? ' focused' : ''}`}
											data-group={node.group}
											style={`visibility:${node.group === 0 ? 'hidden' : 'visible'}`}
											d={nodeConnectionPath(node)}
											vector-effect="non-scaling-stroke"
										/>
									))
								}
							</svg>
							<svg
								class="connector-lines foreground"
								data-layer="foreground"
								aria-hidden="true"
								viewBox="0 0 1000 1000"
								preserveAspectRatio="none"
							>
								{
									systemNodes.map((node) => (
										<>
											<path
												class={`connector-base${node.group === 0 ? ' focused' : ''}`}
												data-group={node.group}
												style={`visibility:${node.group === 0 ? 'visible' : 'hidden'}`}
												d={nodeConnectionPath(node)}
												vector-effect="non-scaling-stroke"
											/>
											<path
												class="connector-particles"
												data-group={node.group}
												style={`visibility:${node.group === 0 ? 'visible' : 'hidden'}`}
												d={nodeConnectionPath(node)}
												pathLength="100"
												vector-effect="non-scaling-stroke"
											/>
										</>
									))
								}
							</svg>
							<svg
								class="connector-lines foreground hover-connector"
								aria-hidden="true"
								viewBox="0 0 1000 1000"
								preserveAspectRatio="none"
							>
								{
									systemNodes.map((node) => (
										<path
											class="hover-flow"
											data-feature={node.label}
											style="visibility:hidden"
											d={nodeConnectionPath(node)}
											pathLength="1"
											vector-effect="non-scaling-stroke"
										/>
									))
								}
							</svg>
							{
								systemNodes.map((node) => (
									<button
										class={`system-node${node.group === 0 ? ' focused' : ''}`}
										type="button"
										aria-pressed={node.group === 0}
										data-group={node.group}
										data-side={node.side}
										data-position={node.position}
										data-label={node.label}
										style={`--depth:${node.depth};--anchor:${node.x}%;--angle:${node.angle}deg;top:${node.y}%`}
									>
										<Icon name={node.icon} size={21} /><span>{node.label}</span>
									</button>
								))
							}
							<div class="agent-core" aria-hidden="true">
								<div class="core-ring"></div>
								<img src="/img/mascot.png" alt="" width="130" height="130" /><span
									>evonic<span class="brand-dot">.</span></span
								>
							</div>
						</div>
						<div class="stage-description" aria-live="polite">
							<span>{steps[0].label}</span>
							<p>{steps[0].detail}</p>
						</div>
					</div>
					<div class="step-grid" aria-label="Explore three Evonic capabilities">
						{
							steps.map((step, i) => (
								<button class={`step${i === 0 ? ' active' : ''}`} data-index={i} aria-pressed={i === 0} data-reveal>
									<div class="step-top">
										<span>{step.category}</span><Icon name={step.icon} size={20} />
									</div>
									<h3>{step.title}</h3>
									<p>{step.text}</p>
									<span class="step-progress" />
								</button>
							))
						}
					</div>
				</section>

				<section class="capability-section section-shell" aria-labelledby="capability-title">
					<div class="section-heading capability-heading" data-reveal>
						<p class="eyebrow">BUILT FOR TRUSTED AUTONOMY</p>
						<h2 id="capability-title">
							Memory that lasts.<br /><span class="gradient-text">Reach that goes further.</span>
						</h2>
					</div>
					<div class="capability-grid">
						<article class="feature-card context-card" data-reveal>
							<div class="context-visual"><CapabilityVisual kind="memory" /></div>
							<p class="eyebrow">EVOMEM · PERSISTENT KNOWLEDGE</p>
							<h2>Remember more.<br /><span class="gradient-text">Retrieve what matters.</span></h2>
							<p>
								Give agents lasting memory from your Markdown files. Evomem combines keyword search,
								vector retrieval, and a knowledge graph to find relevant context without an LLM call at
								query time. Your knowledge stays easy to edit, back up, and version.
							</p>
							<div class="capability-tags">
								<span>Persistent memory</span><span>Hybrid search</span><span>Markdown files</span>
							</div>
							<a class="text-link" href="https://github.com/anvie/evomem"
								>Explore Evomem <Icon name="external" size={18} /></a
							>
						</article>
						<article class="feature-card evonet-card" data-reveal>
							<div class="evonet-visual"><CapabilityVisual kind="network" /></div>
							<p class="eyebrow">EVONET · ANYWHERE EXECUTION</p>
							<h2>Your agents.<br /><span class="gradient-text">Your infrastructure.</span></h2>
							<p>
								Put agents to work on laptops, servers, and edge devices. Evonet connects each device to
								Evonic through an outbound tunnel, so agents can run commands and work with files
								without SSH access, port forwarding, or a public IP.
							</p>
							<div class="capability-tags">
								<span>Outbound connection</span><span>No public IP</span><span>Auto reconnect</span>
							</div>
							<a class="text-link" href="https://github.com/anvie/evonic/tree/main/evonet"
								>Explore Evonet <Icon name="external" size={18} /></a
							>
						</article>
					</div>
				</section>

				<section class="workflow section-shell" aria-labelledby="workflow-title">
					<div class="section-heading" data-reveal>
						<p class="eyebrow">BRING THE WORK TO YOUR AGENTS</p>
						<h2 id="workflow-title">
							Meet your workflow<br /><span class="gradient-text">where it is.</span>
						</h2>
					</div>
					<div class="workflow-grid">
						<article class="feature-card channel-card" data-reveal>
							<div class="channel-visual" aria-hidden="true">
								<span><Icon name="globe" size={28} /></span><span
									><svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"
										><path d="m21 3-4 18-6-5-3 3 1-6 9-7-11 6-5-2Z" /></svg
									></span
								><span><Icon name="chat" size={28} /></span><span
									><svg
										viewBox="0 0 24 24"
										width="28"
										height="28"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										><path d="m5 5 4-1 1 2h4l1-2 4 1 3 13-5 2-1-3H8l-1 3-5-2Z" /><circle
											cx="8"
											cy="12"
											r="1.5"
										/><circle cx="16" cy="12" r="1.5" /></svg
									></span
								>
							</div>
							<h3>Talk in familiar channels</h3>
							<p>Web, Telegram, WhatsApp, and Discord.</p>
							<div class="card-bottom">
								<span>Conversations connected to agent capabilities.</span><Icon name="chat" size={18} />
							</div>
						</article>
						<article class="feature-card schedule-card" data-reveal>
							<div class="schedule-visual" aria-hidden="true">
								<div class="timeline-line"></div>
								<div class="schedule-pill">
									<span class="status-dot"></span><span>Recurring task</span><span class="schedule-time"
										>09:00</span
									><Icon name="check" size={16} />
								</div>
								<div class="schedule-pill next">
									<Icon name="clock" size={14} /><span>Next run scheduled</span><span class="schedule-time"
										>Tomorrow</span
									>
								</div>
							</div>
							<h3>Keep recurring work moving</h3>
							<p>Use cron-based triggers, recurring tasks, and reminders.</p>
							<div class="card-bottom">
								<span>Manage the system through the dashboard or CLI.</span><Icon name="clock" size={18} />
							</div>
						</article>
					</div>
				</section>

				<Contributors />

				<section class="final-cta section-shell" aria-labelledby="cta-title">
					<div class="cta-lines" aria-hidden="true"></div>
					<div class="cta-glow" aria-hidden="true"></div>
					<div class="cta-content" data-reveal>
						<img src="/img/mascot.png" alt="" width="110" height="110" loading="lazy" />
						<p class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</p>
						<h2 id="cta-title">
							Make room for<br /><span class="gradient-text">your first agent.</span>
						</h2>
						<p>Choose a model endpoint. Set up Evonic. Start building.</p>
						<a class="button" href={docs}
							>Get started with Evonic <span class="button-icon"><Icon name="arrow" size={18} /></span></a
						><span class="cta-note">Python 3.10+ <span>·</span> Local or cloud models</span>
					</div>
				</section>
			</main>

			<footer class="section-shell">
				<div class="footer-top">
					<div>
						<a class="brand" href="#top"
							><img src="/img/mascot.png" alt="" width="34" height="34" />evonic<span class="brand-dot"
								>.</span
							></a
						>
						<p>Your Models. Your Rules. Your Swarm.</p>
					</div>
					<nav aria-label="Footer navigation">
						<a href="#contributors">Contributors</a>
						<a href={docs}>Documentation <Icon name="external" size={14} /></a><a
							href={github}
							target="_blank"
							rel="noreferrer">GitHub <Icon name="external" size={14} /></a
						><a href="https://github.com/anvie/evonic/blob/main/LICENSE"
							>License <Icon name="external" size={14} /></a
						>
					</nav>
				</div>
				<div class="footer-bottom">
					<span>© 2026 Evonic · Built by <a href="https://github.com/anvie">Robin Syihab</a></span
					><button class="motion-toggle" aria-pressed="false"
						><span class="motion-indicator"><i></i><i></i><i></i></span
						><span class="motion-label">Pause motion</span></button
					><a href="#top">Back to top ↑</a>
				</div>
			</footer>
		</div>

		<script>
			import { prefersLightweightMotion } from '../lib/motion-profile';

			const root = document.getElementById('top');
			const header = document.querySelector('header');
			const toggle = document.querySelector('.menu-toggle');
			const nav = document.getElementById('main-nav');
			const menuOpenIcon = document.querySelector('.menu-toggle .menu-open');
			const menuCloseIcon = document.querySelector('.menu-toggle .menu-close');
			const motionToggle = document.querySelector('.motion-toggle');
			const motionLabel = document.querySelector('.motion-label');
			const motionIndicator = document.querySelector('.motion-indicator');

			let menuOpen = false;
			let motionPaused = false;
			let lightweight = true;
			let installMode = 'one-liner';
			let copied = false;

			const installCommands = {
				'one-liner': 'curl -fsSL https://evonic.dev/install.sh | bash',
				manual: 'git clone https://github.com/anvie/evonic'
			};
			const stepCopy = [
				{ label: 'Agent identity', detail: 'A purpose. A personality. Possibilities.' },
				{ label: 'Anywhere execution', detail: 'Local. Remote. Wherever work happens.' },
				{ label: 'A connected system', detail: 'Independent agents. Shared possibilities.' }
			];
			const iconPaths = {
				copy: 'M8 8h11v11H8V8Zm-3 8H4V4h12v1',
				check: 'm5 12 4 4L19 6'
			};

			const setMenu = (open) => {
				menuOpen = open;
				nav?.classList.toggle('open', open);
				menuOpenIcon?.toggleAttribute('hidden', open);
				menuCloseIcon?.toggleAttribute('hidden', !open);
				toggle?.setAttribute('aria-expanded', String(open));
				toggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
			};
			toggle?.addEventListener('click', () => setMenu(!menuOpen));
			nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && menuOpen) {
					setMenu(false);
					toggle?.focus();
				}
			});

			const stage = document.querySelector('.process-stage');
			const stageLabel = document.querySelector('.stage-description > span');
			const stageDetail = document.querySelector('.stage-description p');
			const stepButtons = [...document.querySelectorAll('.step')];
			const systemNodes = [...document.querySelectorAll('.system-node')];
			const hoverPaths = [...document.querySelectorAll('.hover-connector path')];

			const setHover = (label) => {
				hoverPaths.forEach((path) => {
					const match = label !== null && path.dataset.feature === label;
					path.style.visibility = match ? 'visible' : 'hidden';
					if (match) path.getAnimations().forEach((animation) => (animation.currentTime = 0));
				});
			};
			const setStep = (step) => {
				if (stage) stage.dataset.step = String(step);
				document.querySelectorAll('.connector-lines[data-layer]').forEach((svg) => {
					const foreground = svg.dataset.layer === 'foreground';
					svg.querySelectorAll('.connector-base[data-group]').forEach((path) => {
						const group = Number(path.dataset.group);
						path.style.visibility = (group === step) === foreground ? 'visible' : 'hidden';
						path.classList.toggle('focused', group === step);
					});
					svg.querySelectorAll('.connector-particles[data-group]').forEach((path) => {
						path.style.visibility = Number(path.dataset.group) === step ? 'visible' : 'hidden';
					});
				});
				systemNodes.forEach((node) => {
					const on = Number(node.dataset.group) === step;
					node.classList.toggle('focused', on);
					node.setAttribute('aria-pressed', String(on));
				});
				stepButtons.forEach((button, index) => {
					button.classList.toggle('active', index === step);
					button.setAttribute('aria-pressed', String(index === step));
				});
				if (stageLabel && stageDetail && stepCopy[step]) {
					stageLabel.textContent = stepCopy[step].label;
					stageDetail.textContent = stepCopy[step].detail;
				}
			};
			systemNodes.forEach((node) => {
				node.addEventListener('click', () => setStep(Number(node.dataset.group)));
				node.addEventListener('focus', () => setHover(node.dataset.label ?? null));
				node.addEventListener('blur', () => setHover(null));
				node.addEventListener('pointerenter', (event) => {
					if (event.pointerType === 'mouse') setHover(node.dataset.label ?? null);
				});
				node.addEventListener('pointerleave', () => setHover(null));
			});
			stepButtons.forEach((button) => button.addEventListener('click', () => setStep(Number(button.dataset.index))));

			const installTabs = [...document.querySelectorAll('.install-tabs button')];
			const installNote = document.querySelector('.install-content > p');
			const commandLine = document.querySelector('.command-line code');
			const copyButton = document.querySelector('.copy-install');
			const copyLabel = document.querySelector('.copy-label');
			const copyIconPath = document.querySelector('.copy-install svg path');

			const updateCopyState = () => {
				if (copyLabel) copyLabel.textContent = copied ? 'Copied' : 'Copy';
				copyIconPath?.setAttribute('d', copied ? iconPaths.check : iconPaths.copy);
			};
			const setInstallMode = (mode) => {
				installMode = mode;
				copied = false;
				installTabs.forEach((tab) => {
					const on = tab.dataset.mode === mode;
					tab.classList.toggle('active', on);
					tab.setAttribute('aria-selected', String(on));
				});
				if (installNote) {
					installNote.textContent =
						mode === 'one-liner' ? 'Install everything in one command.' : 'Clone the repository to begin.';
				}
				if (commandLine) {
					const prompt = document.createElement('span');
					prompt.textContent = '$';
					commandLine.replaceChildren(prompt, document.createTextNode(` ${installCommands[mode]}`));
				}
				updateCopyState();
			};
			installTabs.forEach((tab) => tab.addEventListener('click', () => setInstallMode(tab.dataset.mode)));
			copyButton?.addEventListener('click', async () => {
				await navigator.clipboard.writeText(installCommands[installMode]);
				copied = true;
				updateCopyState();
				window.setTimeout(() => {
					copied = false;
					updateCopyState();
				}, 1600);
			});

			const workspaceTabs = [...document.querySelectorAll('.workspace-tab')];
			const workspacePanels = [...document.querySelectorAll('.dashboard-crop')];
			const setWorkspaceTab = (index) => {
				workspaceTabs.forEach((tab, i) => {
					const on = i === index;
					tab.classList.toggle('active', on);
					tab.setAttribute('aria-selected', String(on));
				});
				workspacePanels.forEach((panel, i) => {
					const on = i === index;
					panel.hidden = !on;
					const existing = panel.querySelector('video');
					if (on && !existing) {
						const video = document.createElement('video');
						video.src = panel.dataset.src ?? '';
						video.setAttribute('aria-label', `${panel.dataset.title} preview`);
						video.autoplay = true;
						video.muted = true;
						video.loop = true;
						video.playsInline = true;
						video.preload = 'auto';
						panel.append(video);
					} else if (!on && existing) {
						existing.remove();
					}
				});
			};
			workspaceTabs.forEach((tab, i) => tab.addEventListener('click', () => setWorkspaceTab(i)));

			const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 30);
			window.addEventListener('scroll', onScroll, { passive: true });
			onScroll();

			const regions = root?.querySelectorAll('main > section, footer') ?? [];
			const visibilityObserver = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					entry.target.dataset.motionVisible = String(entry.isIntersecting);
				});
			});
			regions.forEach((region) => visibilityObserver.observe(region));

			const onVisibility = () => root?.classList.toggle('page-hidden', document.hidden);
			document.addEventListener('visibilitychange', onVisibility);
			onVisibility();

			const preference = matchMedia('(prefers-reduced-motion: reduce)');
			const viewport = matchMedia('(pointer: coarse), (max-width: 720px)');
			const desktopPointer = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 721px)');
			lightweight = prefersLightweightMotion();
			motionPaused = preference.matches;
			let stopDesktopMotion;
			let generation = 0;
			let revealObserver;
			let motionObserver;
			let reveals = [];

			const setup = async (paused) => {
				const currentGeneration = ++generation;
				const smoothScroll = desktopPointer.matches;
				document.documentElement.classList.toggle('motion-disabled', paused);
				root?.classList.toggle('motion-paused', paused);
				root?.classList.toggle('lightweight', lightweight);
				stopDesktopMotion?.();
				stopDesktopMotion = undefined;
				if (root) delete root.dataset.desktopMotion;
				revealObserver?.disconnect();
				motionObserver?.disconnect();
				reveals.forEach((animation) => animation.cancel());
				reveals = [];
				motionToggle?.setAttribute('aria-pressed', String(paused));
				motionIndicator?.classList.toggle('paused', paused);
				if (motionLabel) motionLabel.textContent = paused ? 'Enable motion' : 'Pause motion';
				window.dispatchEvent(new CustomEvent('evonic:motion', { detail: { paused } }));
				if (paused) return;

				// One-shot reveals need no scroll listener and leave no permanent GPU layer.
				revealObserver = new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							observer.unobserve(entry.target);
							const animation = entry.target.animate(
								[
									{ opacity: 0, transform: `translateY(${lightweight ? 8 : 28}px)` },
									{ opacity: 1, transform: 'none' }
								],
								{ duration: lightweight ? 260 : 650, easing: 'cubic-bezier(.22,1,.36,1)' }
							);
							reveals.push(animation);
							animation.onfinish = () => {
								const index = reveals.indexOf(animation);
								if (index >= 0) reveals.splice(index, 1);
							};
						});
					},
					{ threshold: 0.08 }
				);
				root?.querySelectorAll('[data-reveal]').forEach((el) => revealObserver?.observe(el));

				// Preserve the same marquee on every profile; defer its library on lighter devices.
				const loadMotion = async () => {
					motionObserver?.disconnect();
					try {
						const { startDesktopMotion } = await import('../lib/desktop-motion');
						if (currentGeneration !== generation) return;
						stopDesktopMotion = startDesktopMotion(root, {
							animateHero: !lightweight,
							smoothScroll
						});
						if (root) root.dataset.desktopMotion = 'ready';
					} catch (error) {
						console.warn('Scroll animation unavailable; using native scrolling.', error);
					}
				};
				const manifesto = root?.querySelector('.manifesto');
				if (lightweight && !smoothScroll && manifesto) {
					motionObserver = new IntersectionObserver(
						(entries) => {
							if (entries.some((entry) => entry.isIntersecting)) void loadMotion();
						},
						{ rootMargin: '300px 0px' }
					);
					motionObserver.observe(manifesto);
				} else {
					void loadMotion();
				}
			};

			void setup(motionPaused);
			motionToggle?.addEventListener('click', () => {
				motionPaused = !motionPaused;
				void setup(motionPaused);
			});
			preference.addEventListener('change', () => {
				motionPaused = preference.matches;
				void setup(motionPaused);
			});
			const updateProfile = () => {
				lightweight = prefersLightweightMotion();
				void setup(motionPaused);
			};
			viewport.addEventListener('change', updateProfile);
			desktopPointer.addEventListener('change', updateProfile);
		</script>
	</body>
</html>
