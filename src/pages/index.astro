		<script>
			import { prefersLightweightMotion } from '../lib/motion-profile';
			import { swapText } from '../lib/text-swap';
			import { openGate } from '../lib/gate';
			import { initSoundNote } from '../lib/sound-note';
			import { startReveals } from '../lib/reveal';

			const root = document.getElementById('top');
			const header = document.querySelector('header');
			const toggle = document.querySelector('.menu-toggle');
			const nav = document.getElementById('main-nav');
			const motionToggle = document.querySelector('.motion-toggle');
			const motionLabel = document.querySelector('.motion-label');
			const motionIndicator = document.querySelector('.motion-indicator');

			let menuOpen = false;
			let motionPaused = false;
			let lightweight = true;
			let installMode = 'one-liner';
			let copied = false;

			const installCommands = {
				'one-liner': 'curl -fsSL https://evonic.dev/install.sh | bash',
				manual: 'git clone https://github.com/anvie/evonic'
			};
			const stepCopy = [
				{ label: 'Agent identity', detail: 'A purpose. A personality. Possibilities.' },
				{ label: 'Anywhere execution', detail: 'Local. Remote. Wherever work happens.' },
				{ label: 'A connected system', detail: 'Independent agents. Shared possibilities.' }
			];
			const iconPaths = {
				copy: 'M8 8h11v11H8V8Zm-3 8H4V4h12v1',
				check: 'm5 12 4 4L19 6'
			};

			const setMenu = (open) => {
				menuOpen = open;
				nav?.classList.toggle('open', open);
				toggle?.setAttribute('aria-expanded', String(open));
				toggle?.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
			};
			toggle?.addEventListener('click', () => setMenu(!menuOpen));
			nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && menuOpen) {
					setMenu(false);
					toggle?.focus();
				}
			});

			const stage = document.querySelector('.process-stage');
			const stageLabel = document.querySelector('.stage-description > span');
			const stageDetail = document.querySelector('.stage-description p');
			const stepButtons = [...document.querySelectorAll('.step')];
			const systemNodes = [...document.querySelectorAll('.system-node')];
			const hoverPaths = [...document.querySelectorAll('.hover-connector path')];

			const setHover = (label) => {
				hoverPaths.forEach((path) => {
					const match = label !== null && path.dataset.feature === label;
					path.style.visibility = match ? 'visible' : 'hidden';
					if (match) path.getAnimations().forEach((animation) => (animation.currentTime = 0));
				});
			};
			const setStep = (step) => {
				if (stage) stage.dataset.step = String(step);
				document.querySelectorAll('.connector-lines[data-layer]').forEach((svg) => {
					const foreground = svg.dataset.layer === 'foreground';
					svg.querySelectorAll('.connector-base[data-group]').forEach((path) => {
						const group = Number(path.dataset.group);
						path.style.visibility = (group === step) === foreground ? 'visible' : 'hidden';
						path.classList.toggle('focused', group === step);
					});
					svg.querySelectorAll('.connector-particles[data-group]').forEach((path) => {
						path.style.visibility = Number(path.dataset.group) === step ? 'visible' : 'hidden';
					});
				});
				systemNodes.forEach((node) => {
					const on = Number(node.dataset.group) === step;
					node.classList.toggle('focused', on);
					node.setAttribute('aria-pressed', String(on));
				});
				stepButtons.forEach((button, index) => {
					button.classList.toggle('active', index === step);
					button.setAttribute('aria-pressed', String(index === step));
				});
				if (stageLabel && stageDetail && stepCopy[step] && stageLabel.textContent !== stepCopy[step].label) {
					const next = stepCopy[step];
					swapText([stageLabel, stageDetail], () => {
						stageLabel.textContent = next.label;
						stageDetail.textContent = next.detail;
					});
				}
			};
			systemNodes.forEach((node) => {
				node.addEventListener('click', () => setStep(Number(node.dataset.group)));
				node.addEventListener('focus', () => setHover(node.dataset.label ?? null));
				node.addEventListener('blur', () => setHover(null));
				node.addEventListener('pointerenter', (event) => {
					if (event.pointerType === 'mouse') setHover(node.dataset.label ?? null);
				});
				node.addEventListener('pointerleave', () => setHover(null));
			});
			stepButtons.forEach((button) => button.addEventListener('click', () => setStep(Number(button.dataset.index))));

			const installTabs = [...document.querySelectorAll('.install-tabs button')];
			// the active tab's marker slides between the tabs (its place and width from the active tab)
			const tabBar = document.querySelector('.install-tabs');
			const placeTabMarker = () => {
				const on = installTabs.find((tab) => tab.classList.contains('active'));
				if (!tabBar || !on) return;
				tabBar.style.setProperty('--tx', `${on.offsetLeft}px`);
				tabBar.style.setProperty('--tw', `${on.offsetWidth}px`);
			};
			placeTabMarker();
			document.fonts?.ready.then(placeTabMarker);
			window.addEventListener('resize', placeTabMarker);
			const installNote = document.querySelector('.install-content > p');
			const commandLine = document.querySelector('.command-line code');
			const copyButton = document.querySelector('.copy-install');
			const copyLabel = document.querySelector('.copy-label');
			const copyIconPath = document.querySelector('.copy-install svg path');

			const updateCopyState = () => {
				const label = copied ? 'Copied' : 'Copy';
				if (copyLabel?.textContent === label) return;
				swapText([copyLabel, copyButton?.querySelector('svg')], () => {
					if (copyLabel) copyLabel.textContent = label;
					copyIconPath?.setAttribute('d', copied ? iconPaths.check : iconPaths.copy);
				});
			};
			const setInstallMode = (mode) => {
				installMode = mode;
				copied = false;
				installTabs.forEach((tab) => {
					const on = tab.dataset.mode === mode;
					tab.classList.toggle('active', on);
					tab.setAttribute('aria-selected', String(on));
				});
				placeTabMarker();
				swapText([installNote, commandLine], () => {
					if (installNote) {
						installNote.textContent =
							mode === 'one-liner' ? 'Install everything in one command.' : 'Clone the repository to begin.';
					}
					if (commandLine) {
						const prompt = document.createElement('span');
						prompt.textContent = '$';
						commandLine.replaceChildren(prompt, document.createTextNode(` ${installCommands[mode]}`));
					}
					updateCopyState();
				});
			};
			installTabs.forEach((tab) => tab.addEventListener('click', () => setInstallMode(tab.dataset.mode)));
			copyButton?.addEventListener('click', async () => {
				await navigator.clipboard.writeText(installCommands[installMode]);
				copied = true;
				updateCopyState();
				window.setTimeout(() => {
					copied = false;
					updateCopyState();
				}, 1600);
			});

			const workspaceTabs = [...document.querySelectorAll('.workspace-tab')];
			const workspacePanels = [...document.querySelectorAll('.dashboard-crop')];
			const setWorkspaceTab = (index) => {
				workspaceTabs.forEach((tab, i) => {
					const on = i === index;
					tab.classList.toggle('active', on);
					tab.setAttribute('aria-selected', String(on));
				});
				workspacePanels.forEach((panel, i) => {
					const on = i === index;
					panel.hidden = !on;
					const existing = panel.querySelector('video');
					if (on && !existing) {
						const video = document.createElement('video');
						video.src = panel.dataset.src ?? '';
						video.setAttribute('aria-label', `${panel.dataset.title} preview`);
						video.autoplay = true;
						video.muted = true;
						video.loop = true;
						video.playsInline = true;
						video.preload = 'auto';
						panel.append(video);
					} else if (!on && existing) {
						existing.remove();
					}
				});
			};
			workspaceTabs.forEach((tab, i) => tab.addEventListener('click', () => setWorkspaceTab(i)));

			// The hero is a heavy WebGL page: a still stands in until it has loaded, and again whenever the hero
			// is off screen, the tab is hidden, or motion is paused.
			const heroSection = document.querySelector('.hero');
			// The pitch under the scene scales with the tour (the tour lays itself out on a 1600-wide frame, or a 900-high
			// one in windows wider than 16:9); on phones the stage leaves room for it instead.
			const heroStageEl = document.querySelector('.hero-stage');
			const heroBrief = document.querySelector('.hero-brief');
			const heroLive = document.querySelector('.hero-live');
			// the tour's own bridge (public/ev8, site.js): where the title starts, pause, busy
			// (a frame that failed to load is a foreign error page: reading it throws, so it simply has no bridge)
			const tourApi = () => {
				try {
					return heroLive?.contentWindow?.evSite;
				} catch {
					return undefined;
				}
			};
			const fitHero = () => {
				if (!heroSection || !heroStageEl || !heroBrief) return;
				const w = heroStageEl.clientWidth;
				const h = heroStageEl.clientHeight;
				const scale = w / Math.max(1, h) >= 16 / 9 ? h / 900 : w / 1600;
				heroSection.style.setProperty('--hero-s', scale.toFixed(4));
				heroSection.style.setProperty('--brief-s', Math.min(scale, 1.1).toFixed(4));
				heroSection.style.setProperty('--brief-h', `${heroBrief.offsetHeight}px`);
				// the header over the full-screen scene lines up with the tour's section cards: the left column's left edge
				// (89 of the tour's 1600-wide frame) and the right column's right edge (1511), as the tour scales and centres
				// that frame for this window (main.js fit)
				const wide = w / Math.max(1, h) >= 16 / 9;
				const fx = wide ? (w / scale - 1600) / 2 : 0;
				header?.style.setProperty('--hx-l', `${Math.round((89 + fx) * scale)}px`);
				header?.style.setProperty('--hx-r', `${Math.round(w - (1511 + fx) * scale)}px`);
				// the header's foot and the title's top in the tour's layout px: its section cards centre, and its cameras
				// frame, between the two
				const title = heroBrief.querySelector('.hero-title');
				const api = tourApi();
				if (api && title) {
					const top0 = heroStageEl.getBoundingClientRect().top;
					// (an upright phone or tablet: the tour lays itself out in CSS px, not on the 1600-wide frame; main.js fit)
					const k = w < 700 || (w < 1100 && h > w * 0.9) ? 1 : scale;
					api.top(((header?.getBoundingClientRect().bottom ?? 58) - top0) / k);
					// pinned (the pitch comes in later, over the scene): the scene has its full height to itself
					// (the pitch sits under the scene: the scene has its full height to itself)
					api.titleTop((h - 56) / k);
				}
				revealHero();
			};
			// The scroll under the hero: the scene drifts up at 0.65 of the page's speed (--py holds it back), the scroll hint
			// fades (--p), and the pitch fades and rises in as it comes up into view (--e). Phones, upright tablets and
			// reduced motion: the pitch simply shows (--e 1), no drift.
			const stacked = matchMedia('(max-width: 860px), (max-width: 1099px) and (orientation: portrait), (prefers-reduced-motion: reduce)');
			let revealFrame = 0;
			function revealHero() {
				cancelAnimationFrame(revealFrame);
				revealFrame = requestAnimationFrame(() => {
					if (!heroSection || !heroStageEl || !heroBrief) return;
					const stageH = heroStageEl.offsetHeight;
					const y = Math.max(0, Math.min(stageH, window.scrollY));
					const still = stacked.matches;
					// (it rests just under the first screen's foot: it comes in over the first third of the scroll)
					const x = still ? 1 : Math.min(1, Math.max(0, (window.scrollY - 30) / (stageH * 0.32)));
					const e = x * x * (3 - 2 * x);
					heroSection.style.setProperty('--py', `${still ? 0 : (y * 0.35).toFixed(1)}px`);
					heroSection.style.setProperty('--p', Math.min(1, y / (stageH * 0.3)).toFixed(4));
					// the foot's fog: on as soon as the page moves (the scene's edge never shows), off at rest
					heroSection.style.setProperty('--fog', window.scrollY > 2 || still ? '1' : '0');
					heroSection.style.setProperty('--e', e.toFixed(4));
					heroSection.classList.toggle('brief-on', e > 0.5);
				});
			}
			window.addEventListener('scroll', revealHero, { passive: true });
			stacked.addEventListener('change', fitHero);
			fitHero();
			window.addEventListener('resize', fitHero);
			document.fonts?.ready.then(fitHero);
			heroLive?.addEventListener('load', fitHero);
			// Is this device one the live tour should not start on by itself (the still and the play button instead)? Judged
			// on evidence, never on a spec that merely sounds modest: a phone that can run the tour must get the tour.
			//   - the visitor asked to save data;
			//   - no hardware-accelerated WebGL (the browser's own answer: software rendering is refused);
			//   - a device that is plainly the weakest sort: two cores or fewer, or 2 GB or less (not Apple's: Safari
			//     reports small numbers there whatever the chip);
			// and for every device the measured frame rate has the last word (watchPace: two slow windows in a row).
			const saveData = navigator.connection?.saveData === true;
			const device = navigator as Navigator & { deviceMemory?: number };
			const apple = /iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
			const hardwareGl = (() => {
				try {
					const c = document.createElement('canvas');
					const gl = c.getContext('webgl2', { failIfMajorPerformanceCaveat: true }) ?? c.getContext('webgl', { failIfMajorPerformanceCaveat: true });
					gl?.getExtension('WEBGL_lose_context')?.loseContext();
					return !!gl;
				} catch {
					return false;
				}
			})();
			const plainlyWeak = !apple && ((navigator.hardwareConcurrency > 0 && navigator.hardwareConcurrency <= 2) || (device.deviceMemory !== undefined && device.deviceMemory <= 2));
			const weak = saveData || !hardwareGl || plainlyWeak;
			const heroPlay = document.querySelector('.hero-play');
			// the still's swim in: only where the still is what the visitor gets from the start (a weak device), with motion
			// allowed and no data to save; it is fetched while the gate is shut and shown (its first frame) behind it
			const swim = document.querySelector<HTMLVideoElement>('.hero-swim');
			const swimWanted = !!swim && weak && !saveData && !matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (swim && swimWanted) {
				swim.src = (matchMedia('(min-width: 721px)').matches ? swim.dataset.wide : swim.dataset.tall) ?? '';
				swim.preload = 'auto';
				swim.addEventListener('loadeddata', () => swim.classList.add('ready'), { once: true });
				swim.load();
			}
			const playSwim = () => {
				if (!swim || !swim.classList.contains('ready')) return;
				// (autoplay refused, as on a phone in low-power mode: the still stays, as it always did)
				swim.play().catch(() => swim.classList.remove('ready'));
			};
			let heroAsked = false;
			heroPlay?.addEventListener('click', () => {
				heroAsked = true;
				heroWanted = true;
				heroPlay.hidden = true;
				syncHero();
			});
			let heroVisible = true;
			let heroWanted = false;
			let heroLoaded = false;
			let heroReady = false;
			let heroFailed = false;
			// (a slow network: the gate opens 4 s after the page is ready at the latest, the still in its place meanwhile)
			let gateDue = false;
			const armGate = () => window.setTimeout(() => ((gateDue = true), syncHero()), Math.max(0, 4000 - performance.now()));
			if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', armGate, { once: true });
			else armGate();
			// (a device that turns out too slow for the live tour: the still and the play button instead; the visitor can
			// still start it. Measured only when it means something: after the gate's doors and dust are done, with the tab
			// shown, the window in focus and the hero on screen; a long gap between frames is the browser holding the page
			// back, not the device, so it is left out; and it takes two slow windows in a row, under 30 frames a second)
			let heroLite = false;
			let partedAt = 0;
			const watchPace = (slowSoFar = 0, tries = 0) => {
				const fair = () => !document.hidden && document.hasFocus() && heroVisible;
				if (heroAsked || heroLite || tries > 8) return;
				// (not yet: the doors and the dust still busy, or the page not in view; look again in a second)
				if (!partedAt || performance.now() - partedAt < 4500 || !fair()) return void window.setTimeout(() => watchPace(slowSoFar, tries + 1), 1000);
				let n = 0;
				let busy = 0;
				let last = performance.now();
				const t0 = last;
				const step = (now) => {
					const gap = now - last;
					last = now;
					if (gap > 250) busy += gap;
					else n++;
					if (!fair()) return void window.setTimeout(() => watchPace(slowSoFar, tries + 1), 1000);
					const el = now - t0 - busy;
					if (el < 3000) return void requestAnimationFrame(step);
					const slow = (n * 1000) / el < 30;
					if (!slow) return;
					if (slowSoFar < 1) return void window.setTimeout(() => watchPace(1, tries + 1), 500);
					heroLite = true;
					if (heroPlay) heroPlay.hidden = false;
					syncHero();
				};
				requestAnimationFrame(step);
			};
			let gateOpen = false;
			let gateWaiting = false;
			const GATE_MIN = 1500;
			// the tour's story starts as the gate's leaves part (it waits on its first frame till then); a tour that loads
			// only after that starts as soon as it is ready
			let tourReleased = false;
			const releaseTour = () => ((tourReleased = true), (partedAt = performance.now()), tourApi()?.go?.());
			const syncHero = () => {
				if (!heroLive) return;
				const on = heroWanted && heroVisible && !document.hidden && !(heroLite && !heroAsked);
				if (on && !heroLoaded) {
					heroLoaded = true;
					heroLive.addEventListener(
						'load',
						() =>
							window.setTimeout(() => {
								if (tourReleased) tourApi()?.go?.();
								heroReady = true;
								// (a slow tour that was given up on after 9 s, and has drawn after all: the still steps aside for it)
								heroFailed = false;
								syncHero();
								window.setTimeout(watchPace, 4000);
							}, 1200),
						{ once: true }
					);
					heroLive.src = heroLive.dataset.src ?? '';
					// (a tour that has not drawn within 9 s: the still comes back)
					window.setTimeout(() => {
						if (!heroReady) (heroFailed = true), syncHero();
					}, 9000);
				}
				// (once loaded, the frame is only made invisible, never display:none: a frame set aside reports a zero
				// size in some browsers and its scene lays out for nothing)
				if (!heroLoaded) heroLive.hidden = !on;
				else (heroLive.hidden = false), (heroLive.style.visibility = on ? '' : 'hidden');
				// off screen or hidden: the tour draws nothing at all
				tourApi()?.pause(!on);
				// The still steps aside once the live tour has drawn its first frames.
				document.documentElement.classList.toggle('tour-on', on && heroReady);
				// the still shows only where the tour does not run (a weak device not asked, motion paused, a failed load):
				// elsewhere the paper stays clear and the tour fades in on its own, never over an old picture
				document.documentElement.classList.toggle('poster-on', (weak && !heroAsked) || motionPaused || heroFailed || (heroLite && !heroAsked));
				// (the gate opened before the tour was ready, a slow network: the still stands in until the tour has drawn)
				document.documentElement.classList.toggle('poster-wait', gateDue && !(on && heroReady));
				// the gate: closed over the whole screen while the tour is summoned, in every case; it opens once the tour has
				// drawn, or the still stands in instead (a weak device, motion paused, a failed load), but never before the seal
				// has been on screen for a moment: GATE_MIN ms from the page's start
				const posterOn = (weak && !heroAsked) || motionPaused || heroFailed || (heroLite && !heroAsked);
				if (!gateOpen && ((on && heroReady) || posterOn || gateDue)) {
					const wait = GATE_MIN - performance.now();
					if (wait > 40) {
						if (!gateWaiting) (gateWaiting = true), window.setTimeout(() => ((gateWaiting = false), syncHero()), wait);
					} else {
						gateOpen = true;
						// (a weak device: the same doors, with a lighter dust; no motion wanted: the leaves only fade)
						const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
						openGate({ calm, light: posterOn, onPart: () => (releaseTour(), playSwim()) });
						// (the sound invitation shows once, under the menu, as the doors finish)
						sound.showOnce(calm ? 600 : 3600);
					}
				}
				// the drifting motes behind the page run while the hero is out of view
				ambient?.classList.toggle('on', !heroVisible && !document.hidden && !motionPaused && !weak);
			};
			const ambient = document.querySelector('.ambient');
			if (heroSection) {
				new IntersectionObserver(([entry]) => {
					heroVisible = entry.isIntersecting;
					syncHero();
				}).observe(heroSection);
				// while the page scrolls, the tour draws at its idle rate
				window.addEventListener('scroll', () => heroVisible && tourApi()?.busy(), { passive: true });
			}
			document.addEventListener('visibilitychange', syncHero);
			window.addEventListener('evonic:motion', (event) => {
				heroWanted = (heroAsked || !weak) && event.detail?.paused !== true;
				if (heroPlay) heroPlay.hidden = heroAsked || !weak || event.detail?.paused === true;
				// Let the page settle before the scene starts downloading.
				if (heroLoaded || !heroWanted) syncHero();
				else if (document.readyState === 'complete') window.setTimeout(syncHero, 200);
				else window.addEventListener('load', () => window.setTimeout(syncHero, 200), { once: true });
			});

			// the sound invitation, the shortcuts (A, P, M) and the first-gesture audio wake: src/lib/sound-note.ts
			const sound = initSoundNote(tourApi);

			// over the hero the header has no paper of its own; past it, a frosted bar
			const onScroll = () => {
				const heroEnd = heroSection ? heroSection.offsetTop + heroSection.offsetHeight : 0;
				// (no paper of its own only while the scene rests under it; once the page moves, the frosted bar keeps the
				// scene drifting under it off the links. One switch for both: the paper, the edges and the wordmark's size
				// change together)
				const over = window.scrollY < 24 && window.scrollY + (header?.offsetHeight ?? 58) < heroEnd - 8;
				header?.classList.toggle('over-hero', over);
				header?.classList.toggle('scrolled', !over);
			};
			window.addEventListener('scroll', onScroll, { passive: true });
			onScroll();

			const regions = root?.querySelectorAll('main > section, footer') ?? [];
			const visibilityObserver = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					entry.target.dataset.motionVisible = String(entry.isIntersecting);
				});
			});
			regions.forEach((region) => visibilityObserver.observe(region));

			const onVisibility = () => root?.classList.toggle('page-hidden', document.hidden);
			document.addEventListener('visibilitychange', onVisibility);
			onVisibility();

			const preference = matchMedia('(prefers-reduced-motion: reduce)');
			const viewport = matchMedia('(pointer: coarse), (max-width: 720px)');
			const desktopPointer = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 721px)');
			lightweight = prefersLightweightMotion();
			motionPaused = preference.matches;
			let stopDesktopMotion;
			let generation = 0;
			let stopReveals: (() => void) | undefined;
			let motionObserver;

			const setup = async (paused) => {
				const currentGeneration = ++generation;
				// Native scrolling: it stays smooth while the hero's tour (same page, same thread) is busy drawing.
				const smoothScroll = false;
				document.documentElement.classList.toggle('motion-disabled', paused);
				root?.classList.toggle('motion-paused', paused);
				root?.classList.toggle('lightweight', lightweight);
				stopDesktopMotion?.();
				stopDesktopMotion = undefined;
				if (root) delete root.dataset.desktopMotion;
				stopReveals?.();
				stopReveals = undefined;
				motionObserver?.disconnect();
				motionToggle?.setAttribute('aria-pressed', String(paused));
				motionIndicator?.classList.toggle('paused', paused);
				if (motionLabel) motionLabel.textContent = paused ? 'Enable motion' : 'Pause motion';
				window.dispatchEvent(new CustomEvent('evonic:motion', { detail: { paused } }));
				if (paused) return;

				// Scroll reveals: src/lib/reveal.ts (one-shot, no scroll listener, nothing left on the compositor).
				stopReveals = startReveals(root, lightweight);

				// Preserve the same marquee on every profile; defer its library on lighter devices.
				const loadMotion = async () => {
					motionObserver?.disconnect();
					try {
						const { startDesktopMotion } = await import('../lib/desktop-motion');
						if (currentGeneration !== generation) return;
						stopDesktopMotion = startDesktopMotion(root, {
							animateHero: !lightweight,
							smoothScroll
						});
						if (root) root.dataset.desktopMotion = 'ready';
					} catch (error) {
						console.warn('Scroll animation unavailable; using native scrolling.', error);
					}
				};
				const manifesto = root?.querySelector('.manifesto');
				if (lightweight && !smoothScroll && manifesto) {
					motionObserver = new IntersectionObserver(
						(entries) => {
							if (entries.some((entry) => entry.isIntersecting)) void loadMotion();
						},
						{ rootMargin: '300px 0px' }
					);
					motionObserver.observe(manifesto);
				} else {
					void loadMotion();
				}
			};

			void setup(motionPaused);
			motionToggle?.addEventListener('click', () => {
				motionPaused = !motionPaused;
				void setup(motionPaused);
			});
			preference.addEventListener('change', () => {
				motionPaused = preference.matches;
				void setup(motionPaused);
			});
			const updateProfile = () => {
				lightweight = prefersLightweightMotion();
				void setup(motionPaused);
			};
			viewport.addEventListener('change', updateProfile);
			desktopPointer.addEventListener('change', updateProfile);
		</script>
	</body>
</html>

