<style>
	.capability-art {
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	/* the routes: ink dashes that keep marching, and a maroon pulse running along each one in turn */
	/* (the routes drawn as the connected system's links: smooth maroon curves) */
	.capability-art :global(.flow) :global(path) {
		stroke: #8a231d;
		stroke-opacity: 0.85;
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	.capability-art :global(.signal) {
		stroke-width: 6.5;
		stroke-linecap: round;
		stroke-dasharray: 0.01 99.99;
		animation: signal-travel 3.2s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
	}
	@keyframes route-march {
		to {
			stroke-dashoffset: -12;
		}
	}
	@keyframes signal-travel {
		to {
			stroke-dashoffset: -100;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.capability-art :global(.signal),
		.capability-art :global(.flow) :global(path) {
			animation: none;
		}
	}
</style>
